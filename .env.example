# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# --- Django ---
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF: origins of the SPA frontend allowed to call this API with credentials ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Postgres (app connection, also used to bootstrap the postgres container) ---
POSTGRES_DB=sprout_warehouse
POSTGRES_USER=sprout_warehouse
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Extra Postgres superuser role, created by db/init/01-init-superuser.sh ---
DB_SUPERUSER_NAME=sprout_warehouse_admin
DB_SUPERUSER_PASSWORD=change-me
